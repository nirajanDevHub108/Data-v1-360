<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Enforce_10_Digit_Numeric_Phone</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    ISBLANK(Phone),
    LEN(Phone) != 10,
    NOT(REGEX(Phone, &quot;[0-9]{10}&quot;))
)</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>Phone number is required and must be exactly 10 numeric digits, with no spaces or special characters.</errorMessage>
</ValidationRule>
